PORT=3001
# Use openai para a API própria integrada à OpenAI.
WORD_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Origens do frontend separadas por vírgula. Não inclua barra final.
ALLOWED_ORIGINS=http://localhost:3000
# Apenas configure 1 se houver exatamente um proxy confiável na hospedagem.
TRUST_PROXY=0
